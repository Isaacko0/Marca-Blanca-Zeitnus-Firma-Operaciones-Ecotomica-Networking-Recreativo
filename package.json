{
  "name": "hscsg-v15-os",
  "version": "15.14.0",
  "description": "HSCSG v15 OS / Cosateca — Sistema operativo comunitario postmonetario (Materialismo Jerárquico + CaaS)",
  "type": "module",
  "scripts": {
      "dev": "vite",
      "build": "vite build",
      "preview": "vite preview",
      "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
      "format": "prettier --write \"src/**/*.{ts,tsx,json,css,md}\"",
      "test": "vitest",
      "typecheck": "tsc --noEmit",
      "license:check": "license-checker --production --failOn GPL-3.0,AGPL-3.0,CC-BY-NC-ND-4.0,Elastic-2.0",
      "license:report": "license-checker --production --csv > license-report.csv",
      "license:ci": "npm run license:check && echo \"License check passed\""
    },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "lucide-react": "^0.453.0",
    "zustand": "^4.5.0",
    "react-router-dom": "^6.20.0",
    "date-fns": "^2.30.0",
    "clsx": "^2.0.0",
    "tailwind-merge": "^2.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.45.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "postcss": "^8.4.30",
    "prettier": "^3.0.0",
    "tailwindcss": "^3.3.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0",
    "license-checker": "^25.0.0"
  }
}
