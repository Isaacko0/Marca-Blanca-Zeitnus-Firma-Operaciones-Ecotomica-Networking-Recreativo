{
  "name": "@hscsg/arm-mcp",
  "version": "0.1.0",
  "description": "ARM MCP Server - Model Context Protocol server over stdio for ARM workspace operations. Zero SDK dependency.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Isaacko0/Marca-Blanca-Zeitnus-Firma-Operaciones-Ecotomica-Networking-Recreativo.git",
    "directory": "packages/arm-mcp"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/**/*.test.ts",
    "spec:validate": "openspec validate --spec openspec/specs/arm-mcp.openspec.yml"
  },
  "keywords": [
    "arm",
    "agent-relationship-management",
    "mcp",
    "model-context-protocol",
    "stdio",
    "hscsg"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@hscsg/arm-core": "file:../arm-core",
    "@hscsg/arm-cli": "file:../arm-cli"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^22.0.0"
  },
  "files": [
    "dist"
  ]
}