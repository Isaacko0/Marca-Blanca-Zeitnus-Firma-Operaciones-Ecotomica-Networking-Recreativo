{
  "name": "@hscsg/arm-loomio",
  "version": "0.1.0",
  "description": "Loomio collaborative decision-making patterns for ARM - Proposal types, STV, weighted voting, anonymous ballots",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./lib": {
      "import": "./dist/lib/index.js",
      "types": "./dist/lib/index.d.ts"
    },
    "./core": {
      "import": "./dist/core/index.js",
      "types": "./dist/core/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "test:watch": "node --watch --test tests/*.test.ts",
    "spec:validate": "node scripts/validate-spec.js"
  },
  "keywords": [
    "loomio",
    "decision-making",
    "collaborative",
    "governance",
    "stv",
    "voting",
    "consensus",
    "arm",
    "hscsg"
  ],
  "author": "HSCSG",
  "license": "AGPL-3.0",
  "dependencies": {
    "@hscsg/arm-core": "file:../arm-core",
    "@hscsg/arm-sensorica": "file:../arm-sensorica",
    "@hscsg/arm-gratiferia": "file:../arm-gratiferia"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "@types/node": "^20.10.0",
    "fast-check": "^3.15.0"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.0.0"
  }
}