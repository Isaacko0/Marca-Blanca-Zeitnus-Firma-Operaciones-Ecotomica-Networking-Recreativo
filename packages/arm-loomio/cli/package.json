{
  "name": "@hscsg/arm-loomio-cli",
  "version": "0.1.0",
  "description": "CLI for ARM Loomio Decision Making",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "arm-loomio": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "dev": "ts-node --transpile-only src/index.ts"
  },
  "keywords": [
    "loomio",
    "decision-making",
