    "commander": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/commander": "^2.12.0",
    "typescript": "^5.3.0",
    "ts-node": "^10.9.0"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.0.0"
  }
}