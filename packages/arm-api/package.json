{
  "name": "@hscsg/arm-api",
  "version": "0.1.0",
  "description": "ARM Loopback API - HTTP API and server for ARM workspace in folder mode. 127.0.0.1 only, SSE for external changes.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Isaacko0/Marca-Blanca-Zeitnus-Firma-Operaciones-Ecotomica-Networking-Recreativo.git",
    "directory": "packages/arm-api"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./api": {
      "import": "./dist/api.js",
      "types": "./dist/api.d.ts"
    },
    "./server": {
      "import": "./dist/server.js",
      "types": "./dist/server.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/**/*.test.ts",
    "spec:validate": "openspec validate --spec openspec/specs/arm-api.openspec.yml"
  },
  "keywords": [
    "arm",
    "agent-relationship-management",
    "api",
    "http",
    "sse",
    "local-first",
    "hscsg"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@hscsg/arm-core": "file:../arm-core",
    "@hscsg/arm-cli": "file:../arm-cli"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^22.0.0"
  },
  "files": [
    "dist"
  ]
}