{
  "name": "@hscsg/arm-ui",
  "version": "0.1.0",
  "description": "ARM UI - React visual CRM with Clear v2 design system. Semantic CSS tokens, violet reserved for agent work.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Isaacko0/Marca-Blanca-Zeitnus-Firma-Operaciones-Ecotomica-Networking-Recreativo.git",
    "directory": "packages/arm-ui"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./App": {
      "import": "./dist/App.js",
      "types": "./dist/App.d.ts"
    },
    "./tokens.css": "./dist/tokens.css",
    "./brand": {
      "import": "./dist/lib/brand.js",
      "types": "./dist/lib/brand.d.ts"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --project tsconfig.build.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/**/*.test.ts",
    "test:e2e": "playwright test",
    "spec:validate": "openspec validate --spec openspec/specs/arm-ui.openspec.yml"
  },
  "keywords": [
    "arm",
    "agent-relationship-management",
    "ui",
    "react",
    "vite",
    "tailwind",
    "hscsg"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@hscsg/arm-core": "file:../arm-core",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "lucide-react": "^0.577.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.9.0",
    "vite": "^8.3.5",
    "@playwright/test": "^1.64.1"
  },
  "files": [
    "dist"
  ]
}